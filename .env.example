# Copy to .env for local use. Never commit a real credential.
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3.8-flash
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_ENABLE_THINKING=true
LEXPILOT_ENABLE_SEMANTIC_AI=true
LLM_REQUEST_TIMEOUT_SECONDS=8
LEXPILOT_CONSULT_TIMEOUT_SECONDS=30
SERPER_API_KEY=
# Optional: real institution addresses. Without a key, official online channels remain available.
AMAP_API_KEY=
# Optional: override the local SQLite law index path.
LEXPILOT_KNOWLEDGE_DB=./.local_data/legal_knowledge.sqlite3
